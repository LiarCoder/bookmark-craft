{
  "name": "bookmark-craft",
  "version": "1.0.0",
  "description": "网页小书签制作工具。提供了一个可调试书签的网页，并且最后可以自动压缩代码并输出符合小书签格式的产物",
  "main": "index.js",
  "scripts": {
    "create": "node scripts/create.js",
    "remove": "node scripts/remove.js",
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "test": "node --test \"test/*.test.js\""
  },
  "keywords": [
    "bookmarklet",
    "terser"
  ],
  "author": "LiarCoder",
  "license": "MIT",
  "dependencies": {
    "terser": "^5.0.0",
    "express": "^4.18.0",
    "chokidar": "^3.5.0"
  }
}
