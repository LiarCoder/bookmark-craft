{
  "name": "bookmark-craft",
  "version": "1.0.0",
  "description": "网页小书签制作工具。提供了一个可调试书签的网页，并且最后可以自动压缩代码并输出符合小书签格式的产物",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "create": "node scripts/create.js",
    "remove": "node scripts/remove.js",
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "test": "node --test \"test/*.test.js\"",
    "check": "npm test && npm run build"
  },
  "keywords": [
    "bookmarklet",
    "terser"
  ],
  "author": "LiarCoder",
  "license": "MIT",
  "devDependencies": {
    "chokidar": "^3.6.0",
    "express": "^4.22.2",
    "terser": "^5.50.0"
  }
}
